{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pilot state.json (pilot/app copy; pilot-v0.4 adds decidedBy)",
  "type": "object",
  "required": ["rev", "items"],
  "additionalProperties": false,
  "properties": {
    "rev": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text", "status", "author", "createdAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(dec|task|src)-[0-9]+$" },
          "kind": { "enum": ["decision", "task", "source"] },
          "text": { "type": "string", "minLength": 3, "maxLength": 240 },
          "status": { "enum": ["proposed", "confirmed", "rejected"] },
          "author": { "enum": ["user", "model"] },
          "model": { "type": "string", "description": "required when author is model" },
          "quote": { "type": "string", "description": "the words in the turn the proposal rests on" },
          "fromMessage": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "decidedAt": { "type": "string", "format": "date-time" },
          "decidedBy": { "enum": ["user"], "description": "who confirmed or rejected the item (pilot-v0.4 extension; only the user decides)" },
          "column": { "enum": ["todo", "doing", "done"], "description": "tasks only" },
          "url": { "type": "string", "description": "sources only" }
        },
        "allOf": [
          { "if": { "properties": { "author": { "const": "model" } } }, "then": { "required": ["model", "quote", "fromMessage"] } },
          { "if": { "properties": { "status": { "enum": ["confirmed", "rejected"] } } }, "then": { "required": ["decidedAt"] } }
        ]
      }
    }
  }
}
