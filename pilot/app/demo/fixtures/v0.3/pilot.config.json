{
  "port": 4750,
  "pilotDir": ".pilot",
  "stallMs": 20000,
  "roles": {
    "chat": {
      "policy": "fallback",
      "allowCloudFallback": false,
      "candidates": [
        { "name": "morrow", "local": true, "baseUrl": "http://127.0.0.1:5752/v1", "model": "fake-morrow", "timeoutMs": 10000 },
        { "name": "frontier", "local": false, "baseUrl": "http://127.0.0.1:5751/v1", "model": "fake-frontier", "timeoutMs": 10000 }
      ]
    },
    "extract": {
      "policy": "manual",
      "everyNTurns": 1,
      "maxItems": 3,
      "candidates": [
        { "name": "morrow", "local": true, "baseUrl": "http://127.0.0.1:5752/v1", "model": "fake-morrow", "structured": true, "timeoutMs": 10000 }
      ]
    },
    "title": {
      "policy": "manual",
      "candidates": []
    }
  },
  "_notes": [
    "DEMO ONLY (npm run demo -- v0.3). Derived from pilot.config.dev.json: own ports (server 4750, fakes 5751/5752) and the chat candidates in privacy-first order (morrow, local, first), so a morrow outage after /model chat auto shows the blocked local->cloud fallback."
  ]
}
