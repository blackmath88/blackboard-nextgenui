{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pilot modules.json",
  "type": "object",
  "required": ["rev", "panes", "answers"],
  "additionalProperties": false,
  "properties": {
    "rev": { "type": "integer", "minimum": 1 },
    "panes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "addedAt", "atCount"],
        "additionalProperties": false,
        "properties": {
          "module": { "enum": ["index", "map", "kanban"] },
          "addedAt": { "type": "string", "format": "date-time" },
          "atCount": { "type": "integer" }
        }
      }
    },
    "answers": {
      "type": "object",
      "description": "module -> last answer",
      "additionalProperties": {
        "type": "object",
        "required": ["answer", "at", "count"],
        "properties": {
          "answer": { "enum": ["yes", "no", "always", "never"] },
          "at": { "type": "string", "format": "date-time" },
          "count": { "type": "integer" }
        }
      }
    },
    "pending": { "type": ["string", "null"], "description": "module awaiting an answer" }
  }
}
