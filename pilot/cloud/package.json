{
  "name": "pilot-cloud",
  "private": true,
  "version": "0.1.0",
  "description": "Pilot Cloud C1: personal hosted Pilot on a Cloudflare Worker with one SQLite Durable Object per user.",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "test": "node --test test/unit/",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/",
    "verify": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
